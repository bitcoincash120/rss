const SEED_POSTS = JSON.parse("[{\"title\": \"Два транша по 6 млн на остаток 10 млн:\", \"marp\": \"---\\nmarp: true\\ntheme: fin-doc\\nsize: carousel\\nlang: ru\\ntitle: \\\"Два транша по 6 млн на остаток 10 млн:\\\"\\n---\\n\\n<article class=\\\"slide dark\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>01/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Лимиты</div>\\n<h3 class=\\\"hero\\\">Два транша по 6 млн на остаток 10 млн:</h3>\\n<p>Как обе заявки проходят проверку одного лимита?</p>\\n<div aria-hidden=\\\"true\\\" class=\\\"ruler\\\"><i></i></div>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>02/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Лимиты</div>\\n<h3>Один остаток виден дважды</h3>\\n<p>В 10:00 два менеджера открыли разные заявки. У каждого на экране 10 млн ₽. Каждый запросил 6 млн ₽.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>03/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Лимиты</div>\\n<h3>Проверка и резерв должны сработать вместе</h3>\\n<p>Когда система подтверждает первый транш, она сразу резервирует 6 млн ₽. Для второй заявки остаётся 4 млн ₽.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>04/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Лимиты</div>\\n<h3>У резерва есть срок жизни</h3>\\n<p>Если клиент отказался от транша, резерв нужно освободить. Иначе следующую выдачу остановят деньги, которые никто не получил.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>05/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Лимиты</div>\\n<h3>Проверьте свой процесс</h3>\\n<p>Попробуйте отправить две заявки одновременно. Подписывайтесь на @fin_doc_, чтобы разбирать такие проверки до запуска кредитного продукта.</p>\\n</div>\\n</article>\"}, {\"title\": \"Клиент загрузил устав. Почему банк просит его снова:\", \"marp\": \"---\\nmarp: true\\ntheme: fin-doc\\nsize: carousel\\nlang: ru\\ntitle: \\\"Клиент загрузил устав. Почему банк просит его снова:\\\"\\n---\\n\\n<article class=\\\"slide dark\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>01/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Досье клиента</div>\\n<h3 class=\\\"hero\\\">Клиент загрузил устав. Почему банк просит его снова:</h3>\\n<p>Файл есть в досье, но новая заявка его не видит.</p>\\n<div aria-hidden=\\\"true\\\" class=\\\"ruler\\\"><i></i></div>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>02/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Досье клиента</div>\\n<h3>Где ищет система?</h3>\\n<p>Устав приложили к прошлой сделке. При открытии новой список документов строится только по её вложениям. Для менеджера строка «Устав» снова пуста.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>03/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Досье клиента</div>\\n<h3>Документ принадлежит компании</h3>\\n<p>Храните версию устава в досье юрлица. В заявке оставляйте ссылку на ту версию, которую сотрудник использовал при проверке.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>04/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Досье клиента</div>\\n<h3>Когда нужен новый запрос?</h3>\\n<p>Перед отправкой письма проверьте, подходит ли имеющаяся версия для этой сделки. Если нужна новая редакция, укажите клиенту причину.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>05/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Досье клиента</div>\\n<h3>Проверьте свой процесс</h3>\\n<p>Посмотрите последнее письмо с запросом документов. Что из списка банк уже получил? В @fin_doc_ показываем, как убрать лишние запросы. Подписывайтесь.</p>\\n</div>\\n</article>\"}, {\"title\": \"Пять дней на решение. Сколько из них заявка лежала в очереди:\", \"marp\": \"---\\nmarp: true\\ntheme: fin-doc\\nsize: carousel\\nlang: ru\\ntitle: \\\"Пять дней на решение. Сколько из них заявка лежала в очереди:\\\"\\n---\\n\\n<article class=\\\"slide dark\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>01/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Кредитный процесс</div>\\n<h3 class=\\\"hero\\\">Пять дней на решение. Сколько из них заявка лежала в очереди:</h3>\\n<p>Отчёт показывает просрочку у аналитика. Разберём, куда ушло время.</p>\\n<div aria-hidden=\\\"true\\\" class=\\\"ruler\\\"><i></i></div>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>02/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Кредитный процесс</div>\\n<h3>Назначение ещё не означает начало работы</h3>\\n<p>Заявка поступила в понедельник в 10:00. Аналитик открыл её в среду в 10:00. Эти двое суток она провела в очереди.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>03/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Кредитный процесс</div>\\n<h3>Зафиксируйте начало проверки</h3>\\n<p>Сохраните в журнале три события: заявка готова к проверке, аналитик взял её в работу, проверка завершена. Так очередь станет видна отдельно.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>04/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Кредитный процесс</div>\\n<h3>Проверьте, почему возникла очередь</h3>\\n<p>Если свободные аналитики были, посмотрите, кому система могла назначить задачу. Фильтр по филиалу иногда оставляет всю очередь одному человеку.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>05/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Кредитный процесс</div>\\n<h3>Проверьте свой процесс</h3>\\n<p>Что ускорит ваше решение: ещё один аналитик или изменение маршрута? Подписывайтесь на @fin_doc_, чтобы находить ответ по журналу заявки.</p>\\n</div>\\n</article>\"}, {\"title\": \"Клиент погасил долг. Почему ему снова звонят:\", \"marp\": \"---\\nmarp: true\\ntheme: fin-doc\\nsize: carousel\\nlang: ru\\ntitle: \\\"Клиент погасил долг. Почему ему снова звонят:\\\"\\n---\\n\\n<article class=\\\"slide dark\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>01/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Взыскание</div>\\n<h3 class=\\\"hero\\\">Клиент погасил долг. Почему ему снова звонят:</h3>\\n<p>Платёж уже отражён в банке, а номер ещё стоит в очереди на обзвон.</p>\\n<div aria-hidden=\\\"true\\\" class=\\\"ruler\\\"><i></i></div>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>02/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Взыскание</div>\\n<h3>Список успел устареть</h3>\\n<p>В 09:00 система передала номер в очередь. В 09:15 банк учёл платёж. В 09:30 оператор открыл задачу из утреннего списка.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>03/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Взыскание</div>\\n<h3>Платёж должен менять очередь</h3>\\n<p>Когда система получает подтверждение полного погашения, она снимает с обзвона задачи по этому долгу. Для частичного погашения нужен отдельный сценарий.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>04/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Взыскание</div>\\n<h3>Проверьте момент звонка</h3>\\n<p>Если оператор уже открыл задачу, перед набором номера запросите текущий статус долга. Так платёж между открытием карточки и звонком тоже будет учтён.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>05/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Взыскание</div>\\n<h3>Проверьте свой процесс</h3>\\n<p>Проследите путь одного погашения до рабочего места оператора. Подписывайтесь на @fin_doc_, чтобы разбирать такие разрывы между учётом и взысканием.</p>\\n</div>\\n</article>\"}, {\"title\": \"Один кредит на 30 млн превратился в 60 млн в воронке:\", \"marp\": \"---\\nmarp: true\\ntheme: fin-doc\\nsize: carousel\\nlang: ru\\ntitle: \\\"Один кредит на 30 млн превратился в 60 млн в воронке:\\\"\\n---\\n\\n<article class=\\\"slide dark\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>01/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Воронка продаж</div>\\n<h3 class=\\\"hero\\\">Один кредит на 30 млн превратился в 60 млн в воронке:</h3>\\n<p>Откуда взялась вторая сделка, если клиент обратился один раз?</p>\\n<div aria-hidden=\\\"true\\\" class=\\\"ruler\\\"><i></i></div>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>02/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Воронка продаж</div>\\n<h3>Один запрос пришёл двумя путями</h3>\\n<p>Клиент оставил заявку на сайте и переслал её менеджеру. Сайт создал сделку автоматически, менеджер завёл вторую вручную.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>03/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Воронка продаж</div>\\n<h3>Совпадение ещё нужно проверить</h3>\\n<p>Покажите менеджеру открытые заявки этого юрлица по тому же продукту. Сумма и дата помогут отличить повторное обращение от второй потребности.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>04/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Воронка продаж</div>\\n<h3>Сохраните оба обращения</h3>\\n<p>Если клиент подтвердил, что речь об одном кредите, привяжите звонок и заявку с сайта к одной сделке. В прогноз продаж её сумма попадёт один раз.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>05/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Воронка продаж</div>\\n<h3>Проверьте свой процесс</h3>\\n<p>Видно ли в вашей CRM, сколько было обращений и сколько за ними сделок? Подписывайтесь на @fin_doc_ за разборами банковских воронок.</p>\\n</div>\\n</article>\"}, {\"title\": \"Комитет одобрил кредит. Что ещё держит выдачу:\", \"marp\": \"---\\nmarp: true\\ntheme: fin-doc\\nsize: carousel\\nlang: ru\\ntitle: \\\"Комитет одобрил кредит. Что ещё держит выдачу:\\\"\\n---\\n\\n<article class=\\\"slide dark\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>01/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Условия выдачи</div>\\n<h3 class=\\\"hero\\\">Комитет одобрил кредит. Что ещё держит выдачу:</h3>\\n<p>В карточке зелёный статус, но менеджер не может назвать клиенту дату выдачи.</p>\\n<div aria-hidden=\\\"true\\\" class=\\\"ruler\\\"><i></i></div>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>02/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Условия выдачи</div>\\n<h3>Условие спряталось в протоколе</h3>\\n<p>Комитет одобрил сделку при условии получения поручительства. В системе отметили решение, а требование осталось абзацем в протоколе.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>03/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Условия выдачи</div>\\n<h3>Дайте условию исполнителя</h3>\\n<p>Создайте по решению задачу: какой документ получить, кто проверяет и к какому сроку. Менеджер увидит, у кого сейчас следующий шаг.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>04/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Условия выдачи</div>\\n<h3>Свяжите проверку с выдачей</h3>\\n<p>Пока поручительство ожидает проверки, покажите причину остановки. Когда ответственный подтвердит документ, разрешите переход к выдаче, если остальные условия выполнены.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>05/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Условия выдачи</div>\\n<h3>Проверьте свой процесс</h3>\\n<p>Откройте одну одобренную сделку. Видно ли, что осталось до выдачи? В @fin_doc_ разбираем путь от протокола до денег на счёте. Подписывайтесь.</p>\\n</div>\\n</article>\"}, {\"title\": \"Банк получил две заявки после одного нажатия:\", \"marp\": \"---\\nmarp: true\\ntheme: fin-doc\\nsize: carousel\\nlang: ru\\ntitle: \\\"Банк получил две заявки после одного нажатия:\\\"\\n---\\n\\n<article class=\\\"slide dark\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>01/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Личный кабинет</div>\\n<h3 class=\\\"hero\\\">Банк получил две заявки после одного нажатия:</h3>\\n<p>Клиент увидел ошибку, нажал «Отправить» ещё раз и получил два номера.</p>\\n<div aria-hidden=\\\"true\\\" class=\\\"ruler\\\"><i></i></div>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>02/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Личный кабинет</div>\\n<h3>Ошибка на экране, заявка в банке</h3>\\n<p>При первом нажатии система успела создать заявку. Ответ задержался, и личный кабинет предложил клиенту повторить отправку.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>03/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Личный кабинет</div>\\n<h3>У повтора тот же номер запроса</h3>\\n<p>Присвойте отправке идентификатор до первого обращения к серверу. При повторной попытке передавайте его снова, даже если клиент обновил страницу.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>04/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Личный кабинет</div>\\n<h3>Верните уже созданную заявку</h3>\\n<p>Закрепите за идентификатором одну заявку. Если запрос поступит ещё раз, верните клиенту её номер. Правило должно работать и при двух одновременных отправках.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>05/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Личный кабинет</div>\\n<h3>Проверьте свой процесс</h3>\\n<p>Проверьте, что увидит клиент при потере ответа после отправки. Подписывайтесь на @fin_doc_, чтобы находить такие сценарии при приёмке личного кабинета.</p>\\n</div>\\n</article>\"}, {\"title\": \"Клиент отказался. Почему CRM винит ставку:\", \"marp\": \"---\\nmarp: true\\ntheme: fin-doc\\nsize: carousel\\nlang: ru\\ntitle: \\\"Клиент отказался. Почему CRM винит ставку:\\\"\\n---\\n\\n<article class=\\\"slide dark\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>01/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Аналитика CRM</div>\\n<h3 class=\\\"hero\\\">Клиент отказался. Почему CRM винит ставку:</h3>\\n<p>Что окажется в отчёте, если менеджеру нужно закрыть сделку, а причина ему неизвестна?</p>\\n<div aria-hidden=\\\"true\\\" class=\\\"ruler\\\"><i></i></div>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>02/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Аналитика CRM</div>\\n<h3>Первый пункт становится ответом</h3>\\n<p>В форме уже выбрана «Высокая ставка». Менеджер закрывает карточку после трёх звонков без ответа. В отчёте появляется ценовое возражение.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>03/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Аналитика CRM</div>\\n<h3>Разделите два исхода</h3>\\n<p>«Клиент назвал причину» и «Не удалось связаться» описывают разные ситуации. Запрашивайте причину отказа только в первом случае.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>04/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Аналитика CRM</div>\\n<h3>Проверьте вывод на цифрах</h3>\\n<p>Из 20 закрытых сделок в четырёх клиенты назвали ставку, ещё в 16 причина неизвестна. В отчёте покажите обе группы: у руководителя будет основание решить, что изучать дальше.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>05/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Аналитика CRM</div>\\n<h3>Проверьте свой процесс</h3>\\n<p>Посмотрите, какое значение первым встречает менеджера в форме отказа. Подписывайтесь на @fin_doc_, чтобы понимать, как настройки CRM влияют на выводы о продажах.</p>\\n</div>\\n</article>\"}, {\"title\": \"Заявку вернули в филиал. Какой именно файл нужно исправить:\", \"marp\": \"---\\nmarp: true\\ntheme: fin-doc\\nsize: carousel\\nlang: ru\\ntitle: \\\"Заявку вернули в филиал. Какой именно файл нужно исправить:\\\"\\n---\\n\\n<article class=\\\"slide dark\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>01/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Проверка документов</div>\\n<h3 class=\\\"hero\\\">Заявку вернули в филиал. Какой именно файл нужно исправить:</h3>\\n<p>Комментарий «Доработать пакет» запускает ещё один круг переписки.</p>\\n<div aria-hidden=\\\"true\\\" class=\\\"ruler\\\"><i></i></div>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>02/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Проверка документов</div>\\n<h3>Замечание адресовано всей заявке</h3>\\n<p>Проверяющий заметил, что в отчётности нет последней страницы. В филиале видят только статус «На доработке» и заново просматривают весь комплект.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>03/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Проверка документов</div>\\n<h3>Привяжите замечание к файлу</h3>\\n<p>Укажите документ, его версию и конкретное исправление: «Баланс за 2025 год, версия 1. Приложите страницу с подписью».</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>04/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Проверка документов</div>\\n<h3>Верните на проверку исправленный документ</h3>\\n<p>После загрузки новой версии откройте проверяющему файл вместе с исходным замечанием. Он сможет подтвердить исправление или объяснить, что ещё требуется.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>05/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Проверка документов</div>\\n<h3>Проверьте свой процесс</h3>\\n<p>Возьмите последний возврат. Поймёт ли коллега задачу без звонка автору? Подписывайтесь на @fin_doc_ за разборами доработок и повторных согласований.</p>\\n</div>\\n</article>\"}, {\"title\": \"Один перевод ищут сразу два сотрудника банка:\", \"marp\": \"---\\nmarp: true\\ntheme: fin-doc\\nsize: carousel\\nlang: ru\\ntitle: \\\"Один перевод ищут сразу два сотрудника банка:\\\"\\n---\\n\\n<article class=\\\"slide dark\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>01/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Обслуживание</div>\\n<h3 class=\\\"hero\\\">Один перевод ищут сразу два сотрудника банка:</h3>\\n<p>Клиент написал в чат, а за ответом пришёл в офис. Сколько обращений увидит руководитель?</p>\\n<div aria-hidden=\\\"true\\\" class=\\\"ruler\\\"><i></i></div>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>02/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Обслуживание</div>\\n<h3>Два канала завели два дела</h3>\\n<p>В чате выясняют, куда пропал перевод. В отделении регистрируют тот же вопрос заново. У каждого сотрудника своя история и свой срок ответа.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>03/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Обслуживание</div>\\n<h3>Найдите действующее обращение</h3>\\n<p>После идентификации клиента покажите сотруднику его открытые обращения. Дата и номер перевода помогут понять, о той ли операции идёт речь.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>04/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Обслуживание</div>\\n<h3>У вопроса остаётся один ответственный</h3>\\n<p>Добавьте визит в историю найденного обращения. Зафиксируйте, кто сообщит результат клиенту и в каком канале тот ждёт ответ.</p>\\n</div>\\n<div class=\\\"foot\\\"><span></span><span>Листай →</span></div>\\n</article>\\n\\n---\\n\\n<article class=\\\"slide\\\">\\n<div class=\\\"head\\\"><span>@fin_doc_</span><span>05/05</span></div>\\n<div class=\\\"content\\\">\\n<div class=\\\"kicker\\\">Обслуживание</div>\\n<h3>Проверьте свой процесс</h3>\\n<p>Можно ли продолжить в отделении разговор, начатый в чате? Подписывайтесь на @fin_doc_, чтобы разбирать передачу клиентских обращений между каналами.</p>\\n</div>\\n</article>\"}]");

function colByHeader(sheet, names, fallback) {
  const last = Math.max(sheet.getLastColumn(), 1);
  const headers = sheet.getRange(1, 1, 1, last).getValues()[0];
  const wanted = names.map(function (name) {
    return String(name).trim().toLowerCase();
  });
  for (var i = 0; i < headers.length; i++) {
    var label = String(headers[i] || "").trim().toLowerCase().replace(/\s+/g, " ");
    if (wanted.indexOf(label) >= 0) return i + 1;
    for (var w = 0; w < wanted.length; w++) {
      if (label.indexOf(wanted[w]) >= 0 && (wanted[w] === "marp" || wanted[w].indexOf("размет") >= 0 || wanted[w].indexOf("marp") >= 0)) {
        return i + 1;
      }
    }
  }
  return fallback || 0;
}

function marpCol(sheet) {
  const last = Math.max(sheet.getLastColumn(), 1);
  const headers = sheet.getRange(1, 1, 1, last).getValues()[0];
  for (var i = 0; i < headers.length; i++) {
    var n = String(headers[i] || "").trim().toLowerCase();
    if (n.indexOf("marp") >= 0 || n.indexOf("размет") >= 0 || n === "markdown" || n === "md") {
      return i + 1;
    }
  }
  return 0;
}

function sheetHeaders() {
  return ["Статус", "Ссылка", "Заголовок", "Полная разметка Marp (.md)"];
}

function applyLayout(sheet, rows) {
  const header = sheetHeaders();
  const out = [header].concat(rows);
  sheet.clear();
  sheet.getRange(1, 1, out.length, header.length).setValues(out);
  sheet.getRange(1, 1, 1, header.length).setFontWeight("bold");
  sheet.setFrozenRows(1);
  sheet.setFrozenColumns(2);
  sheet.setColumnWidth(1, 140);
  sheet.setColumnWidth(2, 240);
  sheet.setColumnWidth(3, 380);
  sheet.setColumnWidth(4, 720);
  if (out.length > 1) {
    sheet.getRange(2, 4, out.length - 1, 1).setWrap(true);
  }
  return { ok: true, rows: out.length - 1, cols: header.length };
}

function parsePosts(params) {
  params = params || {};
  var posts = params.posts || params.rows || [];
  if (typeof posts === "string") {
    try {
      posts = JSON.parse(posts);
    } catch (err) {
      posts = [];
    }
  }
  return posts || [];
}

function seedLayout(params) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheets()[0];
  var posts = parsePosts(params);
  if (!posts.length) posts = SEED_POSTS;
  const rows = posts.map(function (item) {
    if (Array.isArray(item)) {
      while (item.length < 4) item.push("");
      return [item[0] || "", item[1] || "", item[2] || "", item[3] || ""];
    }
    return ["", "", item.title || "", item.marp || item.markdown || ""];
  });
  return applyLayout(sheet, rows);
}

function seedFindocPosts() {
  return seedLayout({ posts: SEED_POSTS });
}

function listIdeas() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheets()[0];
  const lastRow = Math.max(sheet.getLastRow(), 1);
  const lastCol = Math.max(sheet.getLastColumn(), 1);
  const values = sheet.getRange(1, 1, lastRow, lastCol).getValues();
  const headers = (values[0] || []).map(function (h) {
    return String(h || "").trim().toLowerCase().replace(/\s+/g, " ");
  });
  function idx(names, fallback) {
    for (var i = 0; i < names.length; i++) {
      var found = headers.indexOf(String(names[i]).toLowerCase());
      if (found >= 0) return found;
    }
    for (var h = 0; h < headers.length; h++) {
      for (var n = 0; n < names.length; n++) {
        if (headers[h].indexOf(String(names[n]).toLowerCase()) >= 0) return h;
      }
    }
    return fallback;
  }
  const statusI = idx(["статус", "status"], 0);
  const linkI = idx(["ссылка", "link", "url", "пост"], 1);
  const titleI = idx(["заголовок", "title", "headline", "тема"], 2);
  var marpI = idx(["полная разметка marp (.md)", "полная разметка marp", "полная разметка", "marp", "markdown"], -1);
  if (marpI < 0) {
    for (var c = 0; c < headers.length; c++) {
      if (headers[c].indexOf("marp") >= 0 || headers[c].indexOf("размет") >= 0) marpI = c;
    }
  }
  const imported = { импортирован: 1, imported: 1, готово: 1, published: 1, опубликован: 1 };
  const ideas = [];
  for (var r = 1; r < values.length; r++) {
    var row = values[r] || [];
    var title = String(row[titleI] || "").trim();
    var marp = marpI >= 0 ? String(row[marpI] || "").trim() : "";
    var status = String(row[statusI] || "").trim().toLowerCase();
    if (!title || !marp) continue;
    if (imported[status]) continue;
    var slides = (marp.match(/<article\b/gi) || []).length;
    ideas.push({
      title: title,
      marp: marp,
      description: title,
      cards: [],
      slides: Math.max(1, slides),
      row: r + 1,
      imported: false,
      link: String(row[linkI] || ""),
    });
  }
  return { ok: true, ideas: ideas, rows: ideas.length };
}

function markImported(params) {
  params = params || {};
  const row = Number(params.row);
  const url = String(params.url || "");
  const status = String(params.status || "импортирован");
  if (!row || row < 2) {
    return { ok: false, error: "Нужен номер строки" };
  }
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheets()[0];
  const statusCol = colByHeader(sheet, ["статус", "status"], 1);
  const linkCol = colByHeader(sheet, ["ссылка", "link", "url", "пост"], 2);
  if (!statusCol || !linkCol) {
    return { ok: false, error: "Нет колонок Статус и Ссылка" };
  }
  sheet.getRange(row, statusCol).setValue(status);
  if (url) sheet.getRange(row, linkCol).setValue(url);
  return {
    ok: true,
    row: row,
    status: status,
    url: url,
    statusCol: statusCol,
    linkCol: linkCol,
  };
}

function dispatch(params) {
  params = params || {};
  if (params.action === "ideas") return listIdeas();
  if (params.action === "seed") return seedLayout(params);
  if (params.action === "reshape") return seedLayout(params);
  return markImported(params);
}

function doGet(e) {
  const params = (e && e.parameter) || {};
  const payload = dispatch(params);
  const body = JSON.stringify(payload);
  const cb = params.callback;
  if (cb) {
    return ContentService.createTextOutput(cb + "(" + body + ")").setMimeType(
      ContentService.MimeType.JAVASCRIPT
    );
  }
  return ContentService.createTextOutput(body).setMimeType(ContentService.MimeType.JSON);
}

function doPost(e) {
  const params = (e && e.parameter) || {};
  if (e && e.postData && e.postData.contents) {
    try {
      const json = JSON.parse(e.postData.contents);
      for (const key in json) params[key] = json[key];
    } catch (err) {}
  }
  const payload = dispatch(params);
  return ContentService.createTextOutput(JSON.stringify(payload)).setMimeType(
    ContentService.MimeType.JSON
  );
}

